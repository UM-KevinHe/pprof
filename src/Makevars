# C++17 is requested explicitly so the package no longer depends on how the
# host R configured CXX11/CXX14 (the reason the Databricks notebooks had to
# write ~/.R/Makevars by hand). OpenMP is optional: without it the code runs
# single-threaded.
CXX_STD = CXX17
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
